# PlantOps Environment Configuration Example
# Copy this file to .env and fill in your local MySQL credentials and JWT secret.

APP_NAME="PlantOps – Intelligent Production Scheduling & Planning System"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true

# MySQL Database Connection (plantops_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=plantops_db

# JWT Authentication Settings
# Generate a strong random secret key for production
JWT_SECRET_KEY=plantops-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000

# Scheduling Solver Defaults
DEFAULT_SOLVER_TIME_LIMIT_SECONDS=30
DEFAULT_RANDOM_SEED=20261022

